# Variáveis de ambiente - Copie este arquivo para .env e configure seus valores
# Environment variables - Copy this file to .env and configure your values

# Aplicação / Application
NODE_ENV=development
PORT=3000

# Banco de dados MySQL / MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=sua_senha_aqui
DB_DATABASE=app_financeiro

# JWT
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_mude_em_producao
JWT_EXPIRATION=7d

# Senha reset token expiration (em horas)
RESET_TOKEN_EXPIRATION_HOURS=2

# CORS - URLs permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=10
